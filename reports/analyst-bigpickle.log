[0m$ [0m# Check swagger-ui.html details and alternative swagger paths on services.ozoon.eu
for path in swagger-ui.html swagger-resources/swagger-resources/index.json swagger-resources/configuration/ui swagger-resources/configuration/security; do
  resp=$(curl -s -w "\n%{http_code}" "https://services.ozoon.eu/${path}" 2>&1)
  code=$(echo "$resp" | tail -1)
  echo "${path} -> $code"
  if [ "$code" != "404" ] && [ "$code" != "405" ]; then
    echo "$resp" | head -5
  fi
  echo "---"
done
